<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - D25 Teknologi Pendidikan</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header.ejs', { currentPage: 'products' }) %>

    <section class="page-header">
        <div class="container">
            <nav aria-label="Breadcrumb" style="margin-bottom: 16px;">
                <ol style="display: flex; gap: 8px; list-style: none; font-size: 14px; color: var(--text-secondary); flex-wrap: wrap;">
                    <li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Beranda</a></li>
                    <li aria-hidden="true">/</li>
                    <li><a href="/products" style="color: var(--text-secondary); text-decoration: none;">Produk</a></li>
                    <li aria-hidden="true">/</li>
                    <li aria-current="page" style="color: var(--unm-blue);"><%= product.category %></li>
                </ol>
            </nav>
            <h1><%= product.name %></h1>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="product-detail">
                <div class="product-gallery">
                    <div class="product-main-image">
                        <img src="<%= product.image || product.imageUrl || '/images/product-pdh.svg' %>" alt="<%= product.name %>" onerror="this.onerror=null; this.src='/images/placeholder-product.svg';">
                    </div>
                </div>
                <div class="product-detail-info">
                    <span class="product-detail-category"><%= product.category %></span>
                    <% if (product.brand) { %>
                        <span class="product-brand"><%= product.brand %></span>
                    <% } %>
                    <div class="product-detail-header">
                        <h1><%= product.name %></h1>
                        <div class="product-detail-meta">
                            <% if (product.sku) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                <span>SKU: <%= product.sku %></span>
                            </div>
                            <% } %>
                            <% if (product.brand) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"></path><path d="M12 6v6l4 2"></path></svg>
                                <span><%= product.brand %></span>
                            </div>
                            <% } %>
                            <% if (product.stock !== undefined) { %>
                            <div class="product-detail-meta-item <%= product.stock > 0 ? '' : 'out-of-stock' %>">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                <span>Stok: <%= product.stock > 0 ? product.stock + ' tersedia' : '<span style="color: #dc2626;">Habis</span>' %></span>
                            </div>
                            <% } %>
                            <% if (product.warrantyMonths) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                <span>Garansi: <%= product.warrantyMonths %> bulan</span>
                            </div>
                            <% } %>
                            <% if (product.isDigital) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                <span>Produk Digital</span>
                            </div>
                            <% } %>
                            <% if (product.duration) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <span><%= product.duration %></span>
                            </div>
                            <% } %>
                            <% if (product.level) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                                <span>Level: <%= product.level %></span>
                            </div>
                            <% } %>
                            <% if (product.instructor) { %>
                            <div class="product-detail-meta-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                <span><%= product.instructor %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="product-detail-description">
                        <%= product.description %>
                    </div>
                    
                    <% if (product.specifications && Object.keys(product.specifications).length > 0) { %>
                    <div class="product-specifications">
                        <h4>Spesifikasi</h4>
                        <table class="spec-table">
                            <% Object.entries(product.specifications).forEach(([key, value]) => { %>
                            <tr>
                                <td><%= key %></td>
                                <td><%= value %></td>
                            </tr>
                            <% }) %>
                        </table>
                    </div>
                    <% } %>
                    
                    <% if (product.tags && product.tags.length > 0) { %>
                    <div class="product-tags">
                        <span class="tags-label">Tag:</span>
                        <div class="tags-list">
                            <% product.tags.forEach(tag => { %>
                            <span class="tag"><%= tag %></span>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>
                    
                    <div class="product-detail-price">
                        <span class="price-current"><%= formatRupiah(product.price) %></span>
                        <% if (product.originalPrice && product.originalPrice > product.price) { %>
                        <span class="price-original"><%= formatRupiah(product.originalPrice) %></span>
                        <% } %>
                    </div>
                    <div class="quantity-selector">
                        <label for="quantity">Jumlah:</label>
                        <div class="quantity-input">
                            <button type="button" class="quantity-btn" id="qty-decrease" aria-label="Kurangi jumlah">−</button>
                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="<%= product.stock || 10 %>" readonly>
                            <button type="button" class="quantity-btn" id="qty-increase" aria-label="Tambah jumlah">+</button>
                        </div>
                    </div>

                    <%
                        const apparelText = [product.category, product.name, product.description, Array.isArray(product.tags) ? product.tags.join(' ') : ''].join(' ');
                        const apparelKeywords = /fashion|pakaian|baju|kaos|kemeja|shirt|t-shirt|polo|celana|jeans|clothing|apparel/i;
                        const showSizeSelector = apparelKeywords.test(apparelText);
                    %>
                    <% if (showSizeSelector) { %>
                    <div class="size-selector">
                        <label>Ukuran:</label>
                        <div class="size-options" role="group" aria-label="Pilih ukuran produk">
                            <% const sizePricingConfig = typeof sizePricing !== 'undefined' ? sizePricing : { S: 0, M: 0, L: 0, XL: 0, XXL: 25000, XXXL: 50000 }; %>
                            <% ['S', 'M', 'L', 'XL', 'XXL', 'XXXL'].forEach((sizeOption) => { %>
                            <button type="button" class="size-option <%= sizeOption === 'M' ? 'selected' : '' %>" data-size="<%= sizeOption %>" data-size-price="<%= Number(sizePricingConfig[sizeOption] || 0) %>">
                                <span><%= sizeOption %></span>
                                <% if ((Number(sizePricingConfig[sizeOption] || 0)) > 0) { %>
                                <small>+ <%= formatRupiah(Number(sizePricingConfig[sizeOption] || 0)) %></small>
                                <% } %>
                            </button>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <form action="/add-to-cart/<%= product.id %>" method="POST" class="add-to-cart-form">
                        <% if (showSizeSelector) { %>
                        <input type="hidden" name="size" id="selected-size" value="M">
                        <input type="hidden" name="size_price" id="selected-size-price" value="0">
                        <% } %>
                        <input type="hidden" name="quantity" id="quantity-hidden" value="1">
                        <button type="submit" class="btn btn-primary btn-add-cart" <%= product.stock === 0 ? 'disabled' : '' %>>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                            <%= product.isDigital ? 'Beli Sekarang' : 'Masukkan ke Keranjang' %>
                        </button>
                    </form>
                    
                    <% if (!product.isDigital && (product.specifications || product.warrantyMonths || product.tags)) { %>
                    <div class="product-detail-features">
                        <h4>Info Produk</h4>
                        <ul>
                            <% if (product.warrantyMonths) { %>
                            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> Garansi <%= product.warrantyMonths %> bulan</li>
                            <% } %>
                            <% if (!product.isDigital && product.warrantyMonths === undefined) { %>
                            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> Garansi standar 7 hari</li>
                            <% } %>
                            <% if (product.tags && product.tags.length > 0) { %>
                            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17 4 12"></polyline></svg> Tag: <%= product.tags.join(', ') %></li>
                            <% } %>
                            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Pengiriman ke seluruh Indonesia</li>
                            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Retur & refund 7 hari</li>
                        </ul>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer.ejs') %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const qtyInput = document.getElementById('quantity');
            const qtyHidden = document.getElementById('quantity-hidden');
            const decreaseBtn = document.getElementById('qty-decrease');
            const increaseBtn = document.getElementById('qty-increase');
            const maxQty = parseInt(qtyInput.max) || 10;
            const sizeButtons = document.querySelectorAll('.size-option');
            const selectedSizeInput = document.getElementById('selected-size');
            const selectedSizePriceInput = document.getElementById('selected-size-price');
            const addToCartForm = document.querySelector('.add-to-cart-form');
            
            function updateQty(val) {
                val = Math.max(1, Math.min(maxQty, val));
                qtyInput.value = val;
                qtyHidden.value = val;
            }

            if (sizeButtons.length > 0 && selectedSizeInput) {
                sizeButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        sizeButtons.forEach(item => item.classList.toggle('selected', item === button));
                        selectedSizeInput.value = button.dataset.size;
                        selectedSizePriceInput.value = button.dataset.sizePrice || '0';
                    });
                });

                addToCartForm.addEventListener('submit', (event) => {
                    if (!selectedSizeInput.value) {
                        event.preventDefault();
                        alert('Pilih ukuran terlebih dahulu.');
                    }
                });
            }
            
            decreaseBtn.addEventListener('click', () => updateQty(parseInt(qtyInput.value) - 1));
            increaseBtn.addEventListener('click', () => updateQty(parseInt(qtyInput.value) + 1));
            qtyInput.addEventListener('change', () => updateQty(parseInt(qtyInput.value)));
        });
    </script>
    <style>
        .size-selector { margin-top: 18px; }
        .size-selector label { display: block; margin-bottom: 10px; font-weight: 700; color: var(--text-primary); }
        .size-options { display: flex; flex-wrap: wrap; gap: 8px; }
        .size-option {
            min-width: 78px; padding: 10px 12px; border: 1px solid #dfe7ee; border-radius: 10px; background: #fff;
            color: var(--text-primary); font-weight: 700; cursor: pointer; transition: all 0.2s ease;
            display: flex; flex-direction: column; align-items: center; gap: 2px;
        }
        .size-option small { font-size: 10px; font-weight: 600; opacity: 0.8; }
        .size-option.selected { background: var(--unm-blue); border-color: var(--unm-blue); color: #fff; box-shadow: 0 8px 16px rgba(32, 66, 138, 0.18); }
        .size-option.selected small { color: #fff; }
    </style>
</body>
</html>