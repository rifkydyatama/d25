<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'D25 Teknologi Pendidikan' %> | Universitas Negeri Malang</title>
    <link rel="stylesheet" href="/css/style.css?v=2">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🎓%3C/text%3E%3C/svg%3E">
</head>
<body>
    <header>
        <div class="header-top">
            <div class="container">
                <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                    <a href="mailto:d25teknopendidikan@um.ac.id">✉ d25teknopendidikan@um.ac.id</a>
                    <a href="tel:+6281234567890">📞 +62 812-3456-7890</a>
                    <a href="https://um.ac.id" target="_blank">🌐 um.ac.id</a>
                </div>
                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <a href="#" target="_blank">Instagram</a>
                    <a href="#" target="_blank">YouTube</a>
                    <a href="#" target="_blank">LinkedIn</a>
                </div>
            </div>
        </div>
        <div class="header-main">
            <div class="container header-content">
                <a href="/" class="logo" aria-label="D25 Teknologi Pendidikan - Beranda">
                    <div class="logo-badge">D25</div>
                    <div class="logo-text">
                        <h1>D25 Teknologi Pendidikan</h1>
                        <p>Program Studi Teknologi Pendidikan, Fakultas Ilmu Pendidikan, UM</p>
                    </div>
                </a>
                <nav aria-label="Navigasi utama">
                    <ul>
                        <li><a href="/" <% if (typeof currentPage !== 'undefined' && currentPage === 'home') { %>class="active"<% } %>>Beranda</a></li>
                        <li><a href="/products" <% if (typeof currentPage !== 'undefined' && currentPage === 'products') { %>class="active"<% } %>>Produk</a></li>
                        <li><a href="/cart" class="cart-link" <% if (typeof currentPage !== 'undefined' && currentPage === 'cart') { %>class="active"<% } %>>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                            Keranjang
                            <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                                <span class="cart-count"><%= cartCount %></span>
                            <% } %>
                        </a></li>
                        <li><a href="/lacak-pesanan" <% if (typeof currentPage !== 'undefined' && currentPage === 'tracking') { %>class="active"<% } %>>🔍 Lacak Pesanan</a></li>
                        <% if (typeof user !== 'undefined' && user) { %>
                            <li><a href="/admin" <% if (typeof currentPage !== 'undefined' && currentPage === 'admin') { %>class="active"<% } %>>Admin</a></li>
                            <li><a href="/logout">Logout</a></li>
                        <% } else { %>
                            <li><a href="/login" <% if (typeof currentPage !== 'undefined' && currentPage === 'login') { %>class="active"<% } %>>Login</a></li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
        
        <!-- Mobile Bottom Navigation -->
        <nav class="bottom-nav" aria-label="Navigasi Bawah">
            <a href="/" <% if (typeof currentPage !== 'undefined' && currentPage === 'home') { %>class="active"<% } %>>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                <span>Beranda</span>
            </a>
            <a href="/products" <% if (typeof currentPage !== 'undefined' && currentPage === 'products') { %>class="active"<% } %>>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                <span>Katalog</span>
            </a>
            <a href="/cart" class="cart-link <% if (typeof currentPage !== 'undefined' && currentPage === 'cart') { %>active<% } %>">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span>Keranjang</span>
                <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                    <span class="cart-count"><%= cartCount %></span>
                <% } %>
            </a>
            <a href="/lacak-pesanan" <% if (typeof currentPage !== 'undefined' && currentPage === 'tracking') { %>class="active"<% } %>>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <span>Lacak</span>
            </a>
            <% if (typeof user !== 'undefined' && user) { %>
                <a href="/admin" <% if (typeof currentPage !== 'undefined' && currentPage === 'admin') { %>class="active"<% } %>>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>Akun</span>
                </a>
            <% } else { %>
                <a href="/login" <% if (typeof currentPage !== 'undefined' && currentPage === 'login') { %>class="active"<% } %>>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>Masuk</span>
                </a>
            <% } %>
        </nav>
    </header>
    <main>